# Vet-App BACKEND — production muhit fayli (docker-compose.yml shu faylni o'qiydi).
#   cp .env.prod.example .env.prod   (va to'ldiring)
# .env.prod hech qachon git'ga tushmasin (backend/.gitignore'da bor).
# Frontend sozlamalari alohida: ../frontend/.env.prod.example

# ============ Django ============
# Uzun tasodifiy qator:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
# Domen (frontend'dagi SITE_ADDRESS bilan bir xil)
ALLOWED_HOSTS=vet.example.uz
# HTTPS bo'lsa True; faqat HTTP sinovda False.
COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://vet.example.uz
# Front va API bir domenda — CORS kerak emas.
CORS_ALLOW_ALL_ORIGINS=False

# ============ Ma'lumotlar bazasi ============
# Postgres konteyneri shu qiymatlar bilan yaratiladi; DB_* backend ulanishi uchun (bir xil bo'lsin).
POSTGRES_DB=vetapp
POSTGRES_USER=vetapp
POSTGRES_PASSWORD=
DB_NAME=vetapp
DB_USER=vetapp
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ============ Celery / Redis ============
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# ============ Telegram ============
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_VET_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE=86400

# --- Qo'llab-quvvatlash va javob muddati (pilot) ---
# Ilovadagi "Yordam markazi" shu @username'ga ulanadi (bo'sh = hali ulanmagan xabar).
SUPPORT_TELEGRAM_USERNAME=
# Vet shuncha daqiqada javob bermasa, chaqiruv avtomatik "Muddati tugadi"ga o'tadi.
CALL_RESPONSE_TIMEOUT_MINUTES=30

# --- Xatolik kuzatuvi (ixtiyoriy) ---
# sentry.io'da loyiha ochib DSN'ni shu yerga qo'ying; bo'sh bo'lsa o'chirilgan.
SENTRY_DSN=

# --- Avtomatik zaxira nusxa (ixtiyoriy, sukut qiymatlar yetarli) ---
# Har kuni shu soatda (konteyner UTC vaqti) nusxa olinadi.
BACKUP_HOUR=03
# Shuncha kundan eski nusxalar o'chiriladi.
BACKUP_KEEP_DAYS=14
# Botlar /start'da ochadigan manzillar (HTTPS shart):
TELEGRAM_CLIENT_WEBAPP_URL=https://vet.example.uz/client/
TELEGRAM_VET_WEBAPP_URL=https://vet.example.uz/vet/
