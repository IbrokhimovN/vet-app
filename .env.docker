# Docker compose muhiti (lokal sinov). Sirlar yo'q — dev qiymatlar.
# settings.py .env'ni ham o'qiydi, lekin bu yerdagi qiymatlar ustun turadi
# (django-environ overwrite=False — container env birinchi).

SECRET_KEY=docker-dev-insecure-secret
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Postgres (db service)
DB_NAME=vetapp
DB_USER=vetapp
DB_PASSWORD=vetapp
DB_HOST=db
DB_PORT=5432

# Celery / Redis (redis service) — worker haqiqatan ishlasin
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Telegram botlar (lokal sinovda bo'sh bo'lishi mumkin)
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_VET_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE=86400
