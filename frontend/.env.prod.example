# Vet-App FRONTEND — production muhit fayli (docker-compose.yml shu faylni o'qiydi).
#   cp .env.prod.example .env.prod   (va to'ldiring)
# .env.prod git'ga tushmasin (frontend/.gitignore'da bor).
# Backend sozlamalari alohida: ../backend/.env.prod.example

# Domen yozing — HTTPS sertifikat avtomatik olinadi (80/443 ochiq, DNS shu serverga qaragan bo'lsin).
# Faqat HTTP sinov uchun ":80". Backend'dagi ALLOWED_HOSTS / TELEGRAM_*_WEBAPP_URL bilan mos bo'lsin.
SITE_ADDRESS=vet.example.uz

# Admin panel/API ochiq bo'ladigan IP'lar (probel bilan). Sukut: hamma.
# Misol: ADMIN_ALLOW=203.0.113.7 10.0.0.0/8
ADMIN_ALLOW=0.0.0.0/0 ::/0

# Backend manzili (umumiy `vetapp-edge` tarmog'ida). Odatda o'zgartirish shart emas.
BACKEND_UPSTREAM=vetapp-backend:8000
