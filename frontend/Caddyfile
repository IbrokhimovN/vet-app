# Vet-App frontend (Caddy)
#
# SITE_ADDRESS:
#   vet.example.uz  -> avtomatik HTTPS (Let's Encrypt); 80/443 portlar ochiq va DNS shu serverga qaragan bo'lishi kerak
#   :80             -> faqat HTTP (lokal sinov)
# BACKEND_UPSTREAM: backend manzili (sukut: vetapp-backend:8000, umumiy `vetapp-edge` tarmog'ida)
# ADMIN_ALLOW: admin panel/API ochiq bo'ladigan IP/CIDR ro'yxati (probel bilan).
#   Sukut: hamma. Prod'da o'zingizning IP'ingizni yozing, masalan: 203.0.113.7 10.0.0.0/8
#   Eslatma: Cloudflare kabi proksi ortida bo'lsa, u proksining IP'si ko'rinadi.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# route: ichidagi direktivalar aynan yozilgan tartibda ishlaydi (IP cheklovi birinchi).
	route {
		# --- Admin: faqat ruxsat etilgan IP'lardan ---
		@admin_blocked {
			path /admin-panel /admin-panel/* /admin/* /api/v1/admin/*
			not client_ip {$ADMIN_ALLOW:0.0.0.0/0 ::/0}
		}
		respond @admin_blocked "Ruxsat yo'q" 403

		# --- Backend (Django) ---
		handle /api/* {
			request_body {
				max_size 12MB
			}
			reverse_proxy {$BACKEND_UPSTREAM:vetapp-backend:8000}
		}
		handle /admin/* {
			reverse_proxy {$BACKEND_UPSTREAM:vetapp-backend:8000}
		}
		handle /static/* {
			reverse_proxy {$BACKEND_UPSTREAM:vetapp-backend:8000}
		}

		# Foydalanuvchi yuklagan rasmlar (backend bilan umumiy volume, faqat o'qish)
		handle_path /media/* {
			root * /srv/media
			file_server
		}

		# --- Frontend (statik) ---
		redir /client /client/ permanent
		redir /vet /vet/ permanent
		redir /admin-panel /admin-panel/ permanent
		redir /legal /legal/ permanent

		handle_path /client/* {
			root * /srv/client
			header Cache-Control "no-cache"
			file_server
		}
		handle_path /vet/* {
			root * /srv/vet
			header Cache-Control "no-cache"
			file_server
		}
		handle_path /admin-panel/* {
			root * /srv/admin
			header Cache-Control "no-cache"
			file_server
		}
		# Huquqiy hujjatlar (ommaviy oferta) — login talab qilinmasdan ochiq bo'lishi shart.
		handle_path /legal/* {
			root * /srv/legal
			header Cache-Control "public, max-age=3600"
			file_server
		}

		handle / {
			redir * /client/ 302
		}

		handle {
			respond "Topilmadi" 404
		}
	}
}
