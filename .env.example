# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# --- Ma'lumotlar bazasi (PostgreSQL) ---
# Docker stack ichida:  DB_HOST=db,        DB_PORT=5432
# Lokal dev (Docker DB host porti):  DB_HOST=localhost, DB_PORT=5433
DB_NAME=vetapp
DB_USER=vetapp
DB_PASSWORD=vetapp
DB_HOST=localhost
DB_PORT=5433

# --- CORS (web/mobil mijozlar uchun) ---
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# DEBUG=True bo'lsa tasklar sinxron ishlaydi (Redis shart emas).
CELERY_TASK_ALWAYS_EAGER=True

# --- Telegram botlar (2 ta bot) ---
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_VET_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE=86400

# Botlar /start'da ochadigan Mini App manzillari (HTTPS shart).
# Dev'da tunnel kerak (masalan: ngrok / cloudflared):
#   TELEGRAM_CLIENT_WEBAPP_URL=https://<tunnel>/client/
#   TELEGRAM_VET_WEBAPP_URL=https://<tunnel>/vet/
TELEGRAM_CLIENT_WEBAPP_URL=
TELEGRAM_VET_WEBAPP_URL=
